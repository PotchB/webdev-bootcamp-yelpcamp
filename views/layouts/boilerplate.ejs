<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>YelpCamp</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-yEPZ7jP9S0QKiUQ0m3jjsO4ProIW7wvR9gXkI7JOGa2XVsw53Yke2bsdkBbjmmiX" crossorigin="anonymous">

    <style>
        /* Show "Price cannot be blank." when the invalid input is empty */
        .was-validated .input-group:has(.form-floating > .form-control:invalid:placeholder-shown) .feedback-required {
        display: block;
        }

        /* Show "Price must be greater than or equal to zero." when the invalid input has a value */
        .was-validated .input-group:has(.form-floating > .form-control:invalid:not(:placeholder-shown)) .feedback-min {
        display: block;
        }

        /* Keep the valid feedback rule as-is */
        .was-validated .input-group:has(.form-floating > .form-control:valid) .valid-feedback {
        display: block;
        }
    </style>
</head>
<body class="d-flex flex-column vh-100">
    <%- include('../partials/navbar') %>
    <main class="container mt-4">
        <%- body %>
    </main>
    <%- include('../partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/js/bootstrap.min.js" integrity="sha384-89aa4glufciPv46aKltztWQEmk+Tu9W2RhzXr6VcnUUEub7F8+06RcL2RYLCOHUq" crossorigin="anonymous"></script>
</body>
</html>