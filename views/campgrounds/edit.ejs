<% layout('layouts/boilerplate') %>
<div class="row">
    <h1 class="text-center">Edit Campground</h1>
    <div class="col-6 offset-3">
        <form action="/campgrounds/<%= campground._id %>?_method=PUT" method="POST">
            <div class="form-floating mb-3">
                <input class="form-control" type="text" name="campground[title]" id="title"
                    placeholder="Enter title" value="<%= campground.title %>">
                <label for="title">Title</label>
            </div>
            <div class="form-floating mb-3">
                <input class="form-control" type="text" name="campground[location]" id="location"
                    placeholder="Enter location" value="<%= campground.location %>">
                <label for="location">Location</label>
            </div>
            <div class="form-floating mb-3">
                <input class="form-control" type="text" name="campground[image]" id="image"
                    placeholder="Enter location" value="<%= campground.image %>">
                <label for="image">Image Url</label>
            </div>
            <div class="input-group mb-3">
                <span class="input-group-text">$</span>
                <div class="form-floating">
                    <input class="form-control" type="number" step="0.01" name="campground[price]" id="price"
                        placeholder="0.00" value="<%= campground.price.toFixed(2) %>">
                    <label for="price">Price</label>
                </div>
            </div>
            <div class="form-floating mb-3">
                <textarea class="form-control" style="height: 100px" name="campground[description]" id="description"
                    placeholder="Leave a comment here"><%= campground.description %></textarea>
                <label for="description">Description</label>
            </div>
            <div class="mb-3">
                <button class="btn btn-info">Update Campground</button>
            </div>
        </form>
        <a href="/campgrounds/<%= campground._id %>">Back To Campground</a>
    </div>
</div>